# Reference only: neither Tomcat nor this application loads .env files.
# Set these variables in the environment of the process that starts Tomcat.
EVENT_DB_HOST=localhost
EVENT_DB_PORT=1433
EVENT_DB_NAME=event_booking_test
# Use either sql-password or windows-integrated; integrated requires the native JDBC DLL.
EVENT_DB_AUTH=sql-password
EVENT_DB_USER=
EVENT_DB_PASSWORD=
EVENT_DB_ENCRYPT=true
EVENT_DB_TRUST_SERVER_CERTIFICATE=false

# Session settings are independent of database configuration.
EVENT_SESSION_TIMEOUT_SECONDS=1200
# Enable for HTTPS deployments; leave false for local HTTP.
EVENT_SESSION_COOKIE_SECURE=false
