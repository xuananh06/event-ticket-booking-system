<nav aria-label="Pagination" class="d-flex flex-wrap gap-3 my-4">
<c:if test="${result.previous}"><c:url var="previousUrl" value="${pagingRoute}"><c:param name="page" value="${result.number - 1}"/><c:param name="size" value="${result.size}"/><c:param name="q" value="${param.q}"/><c:param name="category" value="${param.category}"/><c:param name="venue" value="${param.venue}"/><c:param name="from" value="${param.from}"/><c:param name="to" value="${param.to}"/><c:param name="status" value="${param.status}"/><c:param name="filterActive" value="${param.filterActive}"/><c:param name="filterVenue" value="${param.filterVenue}"/></c:url><a class="btn btn-outline-dark" href="<c:out value='${previousUrl}'/>">Previous</a></c:if>
<span class="align-self-center">Page <c:out value="${result.number}"/> · <c:out value="${result.total}"/> records</span>
<c:if test="${result.next}"><c:url var="nextUrl" value="${pagingRoute}"><c:param name="page" value="${result.number + 1}"/><c:param name="size" value="${result.size}"/><c:param name="q" value="${param.q}"/><c:param name="category" value="${param.category}"/><c:param name="venue" value="${param.venue}"/><c:param name="from" value="${param.from}"/><c:param name="to" value="${param.to}"/><c:param name="status" value="${param.status}"/><c:param name="filterActive" value="${param.filterActive}"/><c:param name="filterVenue" value="${param.filterVenue}"/></c:url><a class="btn btn-outline-dark" href="<c:out value='${nextUrl}'/>">Next</a></c:if>
</nav>
